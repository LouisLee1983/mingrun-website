# DeepSeek API key for the AI chat (set in Vercel → Project → Settings → Environment Variables)
DEEPSEEK_API_KEY=
# Optional
DEEPSEEK_MODEL=deepseek-chat
# Public site URL, used for SEO links and sitemap, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=
# Optional: group-bot webhook that receives new inquiries (WeCom / Feishu / DingTalk)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TYPE=wecom
